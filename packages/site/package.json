{
  "name": "@precepts/site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "sync-standards": "tsx scripts/sync-standards.ts",
    "generate-llms-txt": "tsx scripts/generate-llms-txt.ts",
    "start": "pnpm run sync-standards && pnpm run generate-llms-txt && docusaurus start",
    "build": "pnpm run sync-standards && pnpm run generate-llms-txt && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.0",
    "@docusaurus/faster": "3.10.0",
    "@docusaurus/plugin-content-docs": "3.10.0",
    "@docusaurus/preset-classic": "3.10.0",
    "@easyops-cn/docusaurus-search-local": "^0.54.1",
    "@mdx-js/react": "^3.0.0",
    "@precepts/standards": "^0.3.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.0",
    "@docusaurus/tsconfig": "3.10.0",
    "@docusaurus/types": "3.10.0",
    "gray-matter": "^4.0.3",
    "tsx": "^4.19.0",
    "typescript": "~5.6.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
