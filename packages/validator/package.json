{
  "name": "@precepts/validator",
  "version": "0.1.0",
  "description": "CLI validator for Precepts standard documents",
  "type": "module",
  "license": "AGPL-3.0-only",
  "bin": {
    "precepts-validate": "dist/validate.js"
  },
  "scripts": {
    "build": "tsc",
    "validate": "tsx src/validate.ts --docs-root ./node_modules/@precepts/standards/standards",
    "validate:strict": "tsx src/validate.ts --docs-root ./node_modules/@precepts/standards/standards --strict",
    "dev": "tsx src/validate.ts"
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@precepts/standards": "^0.3.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.6.2"
  },
  "engines": {
    "node": ">=20.0"
  }
}
